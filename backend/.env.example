PORT=5000
MONGO_URI=mongodb://username:password@host/database?tls=true&authSource=admin&retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
EXPO_PUBLIC_API_URL=https://your-public-backend.example.com

# Get this from PayMongo Dashboard > Developers > API Keys.
# Start with sk_test_...; never place a secret key in the Expo/mobile .env.
PAYMONGO_SECRET_KEY=sk_test_replace_me

# Public HTTPS backend URL used by PayMongo after checkout.
PAYMONGO_REDIRECT_URL=https://your-public-backend.example.com

EMAIL_USER=
EMAIL_APP_PASSWORD=
CAPTCHA_PORT=5001
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
